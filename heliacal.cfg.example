# "sparcstation5", "sparcstation20", or "axil320"
model = "sparcstation5"
# "cgsix" or "sx" (native SS-20 CG14)
display = "cgsix"
ram_mib = 128
# Paths are relative to this config's directory. Select your own ROMs in F9.
prom = ""
# Required for SS-5, Axil 320 and SS-20 with display = "cgsix".
cgsix_rom = ""
smoothing = false
scanlines = false
show_status = true
tinker = false
network = true

# Entries are in SCSI ID order, 0 through 6. ID 7 is the host adapter.
# Use kind = "disk" or "cdrom" and supply a raw/ISO path to attach media.
# Disks default to read/write; CDs are always read-only. Empty paths leave the target unattached.
scsi = [
  { kind = "disconnected", path = "" }, # ID 0
  { kind = "disconnected", path = "" }, # ID 1
  { kind = "disconnected", path = "" }, # ID 2
  { kind = "disk",         path = "" }, # ID 3
  { kind = "disconnected", path = "" }, # ID 4
  { kind = "disconnected", path = "" }, # ID 5
  { kind = "cdrom",        path = "" }, # ID 6
]
