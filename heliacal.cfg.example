# Optional default named machine (defined below). Otherwise use the flat settings.
# machine_label = "SS20 Solaris 2.6"
# "sparcstation5", "sparcstation20", or "axil320"
model = "sparcstation5"
# "cgsix" or "sx" (native SS-20 CG14)
display = "cgsix"
# F9 > General > Tinker exposes these under Advanced. Headless keeps the control window.
# Original OBP needs initialized NVRAM; OpenBIOS gets separate fresh state.
# See docs/serial-console.md and README firmware selection.
headless = false
# Advanced: false = faster boots (100 ns); true = nominal 85/75 MHz rates.
# Saved per named machine; applies at next boot / confirmed F5.
accurate_cpu_clocks = false
# RTC at startup: host UTC by default; false preserves saved guest time.
# This does not change CPU speed or continuously synchronize the guest clock.
rtc_host_time = true
# Empty: allocated /dev/pts/N only. Optional stable alias, relative to this config.
serial_pty_link = ""
# Exact valid DSIMM total for this model/display; 128 is the default.
# SS-5: up to 256; SS-20/SX: up to 448; SS-20/CGsix or Axil: up to 512 MiB.
ram_mib = 128
# Paths are relative to this config's directory. Select your own ROMs in F9.
# Empty selects the installed OpenBIOS fallback; explicit paths never fall back on errors.
# OpenBIOS requires >=32 MiB, contiguous DRAM, and headless or CGsix (no native SX).
prom = ""
# Required only for graphical CGsix machines; ignored when headless.
cgsix_rom = ""
smoothing = false
scanlines = false
show_status = true
# Shared presentation preference: F9 > Advanced > Serial console view.
# Applies on Save without resetting a headless guest; PTY stays available.
show_serial_console = true
tinker = false
network = true

# Entries are in SCSI ID order, 0 through 6. ID 7 is the host adapter.
# Use kind = "disk" or "cdrom" and supply a raw/ISO path to attach media.
# Disks default to read/write; CDs are always read-only. Empty paths leave the target unattached.
scsi = [
  { kind = "disconnected", path = "" }, # ID 0
  { kind = "disconnected", path = "" }, # ID 1
  { kind = "disconnected", path = "" }, # ID 2
  { kind = "disk",         path = "" }, # ID 3
  { kind = "disconnected", path = "" }, # ID 4
  { kind = "disconnected", path = "" }, # ID 5
  { kind = "cdrom",        path = "" }, # ID 6
]

# F9 > General > Machine label recalls a complete workstation.
# Fill in your image paths, relative to this config or absolute.
# disk/cdrom abbreviate IDs 3/6; menu saves expand them into a full scsi array.
# This SX example needs original OBP; set prom to your SS-20 ROM before booting.
[machines."SS20 Solaris 2.6"]
model = "sparcstation20"
display = "sx"
ram_mib = 448
prom = ""
disk = ""
cdrom = ""
network = true

[machines."SS5 Solaris 7"]
model = "sparcstation5"
ram_mib = 256
prom = ""
cgsix_rom = ""
disk = ""
cdrom = ""

[machines."Axil Solaris 2.6"]
model = "axil320"
ram_mib = 512
prom = ""
cgsix_rom = ""
disk = ""
